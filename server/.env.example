# Nexus Server v2 configuration (copy to .env and edit)

# HTTP listen address. Use 0.0.0.0 so devices on the network can reach it.
HOST=0.0.0.0
PORT=8080

# Data directory (relative to server/). Contains db, storage, backups, logs.
DATA_DIR=./data

# Admin dashboard is protected by user accounts now (first registered user becomes admin).
# A random token secret is auto-generated and stored in data/system/token.key on first run.
# You can override it here instead:
# TOKEN_SECRET=put-a-long-random-string-here

# Server-side backup every N hours (0 disables).
SERVER_BACKUP_HOURS=24

# Heartbeat cadence in milliseconds (Android agents).
HEARTBEAT_INTERVAL_MS=3000

# A node is offline after this many missed heartbeats.
NODE_TIMEOUT_MULTIPLIER=4

# A phone gateway handles this many transfers at once (low power => 1).
MAX_CONCURRENT_TRANSFERS_PER_NODE=1

# Below this battery % a node gets no new work unless charging.
BATTERY_MIN=15

# Above this temperature (Celsius) a node gets no new work.
TEMP_MAX_C=45

# Transfer chunk size in bytes.
CHUNK_SIZE=1048576

# Max bytes accepted per chunk request.
CHUNK_BUFFER_LIMIT=2097152

# Max reassignments of a transfer before it fails.
MAX_REASSIGNMENTS=3

# Retention of metrics / history (days).
METRICS_RETENTION_DAYS=7

# Token lifetimes.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=90

# File versioning.
KEEP_VERSIONS=10
VERSIONING=true
