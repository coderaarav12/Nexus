[Unit]
Description=Nexus SMB share export (materializes files into /opt/nexus/share)
After=nexus.service

[Service]
Type=oneshot
User=nexus
Group=nexus
WorkingDirectory=/opt/nexus/server
Environment=NODE_ENV=production
Environment=npm_config_cache=/opt/nexus/server/data/.npm-cache
ExecStart=/usr/bin/node --import tsx src/tools/exportShare.ts
TimeoutStartSec=600
NoNewPrivileges=true
PrivateTmp=true
